datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Campus {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  emailDomains String
  isActive     Boolean  @default(true)
  users        User[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  username           String?              @unique
  passwordHash       String
  name               String
  phone              String?
  avatarUrl          String?
  role               String               @default("STUDENT") // STUDENT, ADMIN
  isVerified         Boolean              @default(false)
  verificationMethod String?              // CAMPUS_EMAIL, KTM_MANUAL
  verifiedAt         DateTime?
  ktmPhotoPath       String?
  campusId           String?
  campus             Campus?              @relation(fields: [campusId], references: [id])
  sellingItems       Item[]               @relation("SellerItems")
  buyerOrders        Order[]              @relation("BuyerOrders")
  sellerOrders       Order[]              @relation("SellerOrders")
  buyerOffers        Offer[]              @relation("BuyerOffers")
  sellerOffers       Offer[]              @relation("SellerOffers")
  reviewsWritten     Review[]             @relation("BuyerReviews")
  reviewsReceived    Review[]             @relation("SellerReviews")
  balanceEntries     SellerBalanceEntry[]
  payouts            Payout[]
  reportsFiled       Report[]             @relation("ReporterUser")
  orderMessages      OrderMessage[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([campusId])
  @@index([role])
}

model Category {
  id                String   @id @default(uuid())
  name              String   @unique
  slug              String   @unique
  description       String?
  icon              String?
  allowedDelivery   String   @default("PICKUP_OR_DELIVERY") // PICKUP_ONLY, PICKUP_OR_DELIVERY
  requiresSize      Boolean  @default(false)
  requiresCondition Boolean  @default(false)
  isForbidden       Boolean  @default(false)
  displayOrder      Int      @default(0)
  items             Item[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Item {
  id                    String      @id @default(uuid())
  sellerId              String
  seller                User        @relation("SellerItems", fields: [sellerId], references: [id])
  categoryId            String
  category              Category    @relation(fields: [categoryId], references: [id])
  title                 String
  description           String
  priceRupiah           Int
  condition             String      // BARU, SEPERTI_BARU, BEKAS_BAIK, BEKAS_CUKUP
  size                  String?
  brand                 String?
  allowedDeliveryMethod String      @default("PICKUP_OR_DELIVERY") // PICKUP_ONLY, PICKUP_OR_DELIVERY
  pickupLocation        String?
  isNegotiable          Boolean     @default(false)
  status                String      @default("ACTIVE") // ACTIVE, RESERVED, SOLD, ARCHIVED
  photos                ItemPhoto[]
  orders                Order[]
  offers                Offer[]
  reports               Report[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
}

model ItemPhoto {
  id           String   @id @default(uuid())
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url          String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([itemId])
}

model Order {
  id                 String              @id @default(uuid())
  orderNumber        String              @unique
  buyerId            String
  buyer              User                @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId           String
  seller             User                @relation("SellerOrders", fields: [sellerId], references: [id])
  itemId             String
  item               Item                @relation(fields: [itemId], references: [id])
  itemPriceRupiah    Int
  commissionRupiah   Int
  sellerPayoutRupiah Int
  deliveryFeeRupiah  Int
  buyerTotalRupiah   Int
  deliveryMethod     String              // PICKUP, DELIVERY
  deliveryAddress    String?
  deliveryDate       DateTime?
  buyerPhone         String
  paymentMethod      String              // QRIS, COD
  status             String              @default("PENDING_PAYMENT")
  // PENDING_PAYMENT, PAID, PROCESSING, READY_FOR_PICKUP, ON_DELIVERY, COMPLETED, CANCELLED, DISPUTED
  reservedUntil      DateTime?
  notes              String?
  offerId            String?
  paymentProofUrl    String?
  payment            Payment?
  review             Review?
  balanceEntry       SellerBalanceEntry?
  messages           OrderMessage[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([itemId])
  @@index([status])
}

model Payment {
  id            String    @id @default(uuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway       String    @default("MOCK_QRIS")
  paymentType   String    // QRIS, COD
  transactionId String?
  amountRupiah  Int
  qrString      String?
  status        String    @default("PENDING") // PENDING, SETTLED, EXPIRED, FAILED
  rawPayload    String?
  settledAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id])
  sellerId  String
  seller    User     @relation("SellerReviews", fields: [sellerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([sellerId])
}

model SellerBalanceEntry {
  id                 String   @id @default(uuid())
  sellerId           String
  seller             User     @relation(fields: [sellerId], references: [id])
  orderId            String?  @unique
  order              Order?   @relation(fields: [orderId], references: [id])
  type               String   // CREDIT_SALE, DEBIT_WITHDRAWAL, ADJUSTMENT
  amountRupiah       Int
  balanceAfterRupiah Int
  description        String
  createdAt          DateTime @default(now())

  @@index([sellerId])
}

model Payout {
  id                String    @id @default(uuid())
  sellerId          String
  seller            User      @relation(fields: [sellerId], references: [id])
  amountRupiah      Int
  bankName          String
  accountNumber     String
  accountHolderName String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  adminNotes        String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([sellerId])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("ReporterUser", fields: [reporterId], references: [id])
  itemId      String?
  item        Item?    @relation(fields: [itemId], references: [id])
  reason      String   // PROHIBITED_ITEM, MISLEADING, SUSPECTED_FRAUD, OTHER
  description String
  status      String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reporterId])
  @@index([itemId])
}

model OrderMessage {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([senderId])
}

model Offer {
  id               String   @id @default(uuid())
  itemId           String
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User     @relation("BuyerOffers", fields: [buyerId], references: [id])
  sellerId         String
  seller           User     @relation("SellerOffers", fields: [sellerId], references: [id])
  offerPriceRupiah Int
  message          String?
  status           String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED, COMPLETED
  sellerNote       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([itemId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}
